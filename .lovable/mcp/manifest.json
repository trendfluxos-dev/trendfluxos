{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dnodqhwwzdqfqlndwhsf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "trendflux-mcp",
      "version": "0.1.0",
      "title": "TrendFlux Digital"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my TrendFlux profile",
        "description": "Return the signed-in TrendFlux user's profile row (name, email, phone, role).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_enrollments",
        "title": "List my course enrollments",
        "description": "List the signed-in user's TrendFlux Academy module enrollments with status and timestamps.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_strategy_bookings",
        "title": "List strategy bookings (admin)",
        "description": "Admin-only. List TrendFlux strategy call bookings whose scheduled slot falls between `from` and `to` (inclusive). Supports pagination (`limit` + `offset`) and sorting (`sort_by` + `sort_dir`) so large date ranges can be exported page-by-page without timeouts. Returns contact info, session type, status, meeting link, timestamps, and pagination metadata.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "ISO 8601 date or datetime, e.g. 2026-07-01 or 2026-07-01T00:00:00Z"
            },
            "to": {
              "$ref": "#/properties/from"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "confirmed",
                "cancelled",
                "completed",
                "no_show"
              ],
              "description": "Optional status filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Page size (default 200, max 500)."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "Row offset for pagination (default 0). Use `next_offset` from the previous page."
            },
            "sort_by": {
              "type": "string",
              "enum": [
                "scheduled_slot",
                "confirmed_slot_iso",
                "requested_slot_iso",
                "created_at",
                "updated_at"
              ],
              "description": "Sort column. `scheduled_slot` (default) sorts by confirmed_slot_iso and falls back to requested_slot_iso for pending rows."
            },
            "sort_dir": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "description": "Sort direction (default `asc`)."
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
