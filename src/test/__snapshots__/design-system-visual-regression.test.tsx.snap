        div.bg-card.border.border-border.flex.flex-col.relative.rounded-xl.text-card-foreground
          p.font-mono.text-[11px].text-muted-foreground :: story-link
          a.inline-block.mt-3.text-foreground.text-sm :: Underline sweep"
`;
