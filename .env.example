# Lovable Cloud (Supabase) — publishable, safe to expose in client bundle
# Get these from Lovable: Cloud → Settings, or copy from the auto-generated .env
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Optional: override site URL used for canonical tags / share links in production
# VITE_SITE_URL=https://trendflux.digital