# SPA fallback for Apache hosts (Hostinger shared hosting, etc.)
# Lets any deep URL like /the-stand, /stories/ai-expert-emon, /justice
# resolve to index.html so React Router can handle it instead of 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files or directories (assets, sitemap.xml, robots.txt, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → SPA entrypoint (200, not redirect — keeps the URL intact)
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed build assets
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico|mp3|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>